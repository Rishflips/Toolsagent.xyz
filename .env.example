# ── ToolsAgent Environment Variables ──────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to git.

# ── Security (OPTIONAL — generated and persisted automatically if unset) ─
#
# If unset, ToolsAgent generates a cryptographically random secret on first boot
# and persists it into the mounted data volume.
# To override with custom secrets, generate each one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# or:
#   openssl rand -hex 32
#
# Both must be random strings of at least 32 characters. There is no
# default on purpose: a published default would let anyone forge a valid
# login token for every deployment that forgot to change it.

JWT_SECRET=
ENCRYPTION_SECRET=

# ── Database ──────────────────────────────────────────────────────
DB_PASSWORD=toolsagent_dev

# ── URLs ──────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# ── Ports ─────────────────────────────────────────────────────────
BACKEND_PORT=4000
FRONTEND_PORT=3000

# ── AI Provider Keys (optional — only needed for the Deploy module) ─
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Vite (frontend) ───────────────────────────────────────────────
VITE_API_URL=http://localhost:4000
